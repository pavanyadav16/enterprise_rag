# =============================================================================
# Enterprise RAG v2.0.8 -- Embedding Model Server
# Model is downloaded automatically from HuggingFace Hub on first startup.
# No volume mounts or manual model loading required.
# =============================================================================
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential curl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY model_server_requirements.txt requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir -r requirements.txt

COPY model_server.py .
COPY app/utils/properties_loader.py app/utils/properties_loader.py
COPY app/utils/logger_config.py     app/utils/logger_config.py
COPY app/utils/__init__.py          app/utils/__init__.py
COPY app/__init__.py                app/__init__.py
COPY conf/app.properties            conf/app.properties

# Model cache — all HuggingFace downloads go here
RUN mkdir -p /models/cache

RUN useradd -r -u 1001 -g root modeluser \
 && chown -R modeluser:root /app /models
USER modeluser

# Redirect ALL HuggingFace / XET cache to /models/cache (writable by modeluser)
# Prevents "Permission denied" errors on /home/modeluser/.cache/huggingface
ENV HF_HOME=/models/cache
ENV HUGGINGFACE_HUB_CACHE=/models/cache
ENV XDG_CACHE_HOME=/models/cache
ENV TRANSFORMERS_CACHE=/models/cache
ENV HF_DATASETS_CACHE=/models/cache

EXPOSE 8502

HEALTHCHECK --interval=20s --timeout=15s --start-period=180s --retries=10 \
    CMD curl -f http://localhost:8502/health || exit 1

CMD ["uvicorn", "model_server:app", \
     "--host", "0.0.0.0", \
     "--port", "8502", \
     "--workers", "1", \
     "--log-level", "info"]
