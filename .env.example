# =============================================================================
# Enterprise RAG v2.0.8 -- Environment Variables
# =============================================================================
# 1. Copy this file:   cp .env.example .env   (Linux/macOS)
#                      copy .env.example .env  (Windows CMD)
# 2. Fill in every value marked REQUIRED
# 3. Never commit .env to version control (.gitignore already excludes it)
#
# IMPORTANT: Do NOT put comments after values on the same line.
#            Each value must be on its own line with no trailing text.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# true  = bypass JWT entirely — auto-login as admin (local dev/testing only!)
# false = full JWT enforcement (required for production)
APP_DEV_MODE=false

# ---------------------------------------------------------------------------
# External SQL Server  (your existing instance -- NOT in Docker)
# ---------------------------------------------------------------------------
# REQUIRED: hostname or IP address of your SQL Server
DB_HOST=host.docker.internal
DB_PORT=1433
DB_NAME=EnterpriseRAG
# REQUIRED: SQL Server login credentials
DB_USERNAME=sa
DB_PASSWORD=Test123

# ---------------------------------------------------------------------------
# External PostgreSQL + pgvector  (your existing instance -- NOT in Docker)
# ---------------------------------------------------------------------------
# REQUIRED: hostname or IP address of your PostgreSQL server
PGVECTOR_HOST=host.docker.internal
PGVECTOR_PORT=5432
PGVECTOR_DB=rag_vectors
# REQUIRED: PostgreSQL login credentials
PGVECTOR_USER=postgres
PGVECTOR_PASSWORD=test

# ---------------------------------------------------------------------------
# LLM API  (your custom hosted model)
# ---------------------------------------------------------------------------
# REQUIRED: your LLM API endpoints and credentials
LLM_TOKEN_URL=https://your-llm-host/api/v1/token
LLM_GENERATE_URL=https://your-llm-host/api/v1/generate-text
LLM_USERNAME=your_llm_user
LLM_PASSWORD=your_llm_password

# ---------------------------------------------------------------------------
# Embedding model
# ---------------------------------------------------------------------------
# cpu  = works everywhere (default)
# cuda = faster, requires NVIDIA GPU + nvidia-container-toolkit
EMBEDDING_DEVICE=cpu

# ---------------------------------------------------------------------------
# Open WebUI
# ---------------------------------------------------------------------------
# REQUIRED: admin account created on first Open WebUI startup
OWUI_ADMIN_EMAIL=admin@yourcompany.com
OWUI_ADMIN_PASSWORD=ChangeMe123!

# REQUIRED: random secret strings -- generate with:
#   Linux/macOS : openssl rand -hex 32
#   PowerShell  : -join ((1..32)|%{'{0:x}'-f(Get-Random -Max 16)})
OWUI_SECRET_KEY=changeme-replace-with-32-char-random-string
OWUI_AUTO_LOGIN_SECRET=changeme-replace-with-32-char-random-string
